{
  "name": "lifeos",
  "version": "1.0.0",
  "private": true,
  "description": "LifeOS - Personal knowledge management system",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcjabbour/lifeos.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/marcjabbour/lifeos/issues"
  },
  "homepage": "https://github.com/marcjabbour/lifeos#readme",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write .",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:adk": "pnpm --filter adk-agent dev",
    "build:frontend": "pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "build:packages": "pnpm --filter './packages/*' build"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.3.0",
    "typescript": "^5.9.3"
  }
}
