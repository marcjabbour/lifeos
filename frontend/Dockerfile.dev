FROM node:20-alpine

# Install libc compatibility for native binaries (needed for SWC on Alpine)
RUN apk add --no-cache libc6-compat

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

# Copy workspace files
COPY pnpm-workspace.yaml ./
COPY package.json pnpm-lock.yaml ./

# Copy all package.json files for workspace packages
COPY packages/shared/package.json ./packages/shared/
COPY packages/db/package.json ./packages/db/
COPY frontend/package.json ./frontend/

# Install dependencies (this will install platform-specific SWC binaries)
RUN pnpm install

# Copy source (will be mounted in dev mode)
COPY . .

EXPOSE 3001

CMD ["pnpm", "--filter", "frontend", "dev", "--port", "3001"]
