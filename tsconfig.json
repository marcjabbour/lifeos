{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "paths": {
      "@lifeos/shared": ["./packages/shared/src"],
      "@lifeos/shared/*": ["./packages/shared/src/*"],
      "@lifeos/db": ["./packages/db/src"],
      "@lifeos/db/*": ["./packages/db/src/*"]
    }
  },
  "exclude": ["node_modules", "**/node_modules", "dist", "**/dist", ".next", "**/.next"]
}
