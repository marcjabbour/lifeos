# ===========================================
# LifeOS Environment Configuration
# ===========================================
# Copy to .env for Docker, or .env.local for Next.js local dev.
# Docker Compose reads .env automatically from root directory.

# -------------------------------------------
# Supabase
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Backend uses SUPABASE_URL (without NEXT_PUBLIC_ prefix)
SUPABASE_URL=https://your-project.supabase.co

# -------------------------------------------
# AI Services (ADK Agent)
# -------------------------------------------
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-api-key
GOOGLE_AI_API_KEY=your-google-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE
TAVILY_API_KEY=your-tavily-api-key

# -------------------------------------------
# Langfuse (Observability)
# -------------------------------------------
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# -------------------------------------------
# Inngest (Job Queue)
# -------------------------------------------
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# -------------------------------------------
# Twilio / WhatsApp
# -------------------------------------------
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# -------------------------------------------
# Web Push (VAPID)
# -------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# -------------------------------------------
# Feature Flags
# -------------------------------------------
USE_ADK_ORCHESTRATOR=true

# -------------------------------------------
# Development / Misc (Optional)
# -------------------------------------------
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-token
